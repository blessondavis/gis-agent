# ---- Agent LLM (OpenAI-compatible endpoint) -------------------------------
# Works with OpenAI, vLLM, Groq, OpenRouter, Together, LM Studio, ... any
# server that speaks the /v1/chat/completions tool-calling API.
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
GISAGENT_LLM_MODEL=gpt-4o-mini

# ---- Hugging Face --------------------------------------------------------
# facebook/sam3 is GATED: accept the terms at https://huggingface.co/facebook/sam3
# then create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_replace_me
GISAGENT_SAM_MODEL=facebook/sam3

# ---- Runtime -------------------------------------------------------------
GISAGENT_DEVICE=auto          # auto | cuda | cpu
GISAGENT_DATA_DIR=./data
GISAGENT_QGIS_PROCESS=        # blank = auto-detect qgis_process on PATH
